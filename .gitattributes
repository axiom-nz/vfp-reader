# Everything under test/fixtures is data and is compared as bytes, even the
# golden *_summary.txt, *.yml and *.csv files: Git must not convert line
# endings in them, and they are not meant to be merged or diffed.
test/fixtures/** binary

# The human-readable docs are the only text files in the directory.
test/fixtures/README.md text diff merge
test/fixtures/NOTICE text diff merge
