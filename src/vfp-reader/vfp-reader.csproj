<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472</TargetFrameworks>
    <AssemblyName>VfpReader</AssemblyName>
    <RootNamespace>VfpReader</RootNamespace>
    <PackageId>VfpReader</PackageId>
    <Version>0.1.0</Version>
    <Title>VFP / dBase table reader</Title>
    <Description>Read-only, streaming reader for Visual FoxPro, FoxPro 2.x and dBASE III .dbf tables and their .fpt / .dbt memo files.</Description>
    <Authors>axiom-nz</Authors>
    <Copyright>Copyright (c) axiom-nz 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dbf;foxpro;visual-foxpro;dbase;memo;fpt;dbt</PackageTags>
    <PackageProjectUrl>https://github.com/axiom-nz/vfp-reader</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/axiom-nz/vfp-reader</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release: streaming, read-only reader for Visual FoxPro, FoxPro 2.x and dBASE III .dbf tables and their .fpt / .dbt memo files.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.6.3's .NET Framework asset is assembly 4.0.5.0, which is the version the
         .NET SDK's net472 testhost binding-redirects System.Memory to. Staying on
         4.5.5 (assembly 4.0.1.2) makes the testhost load the wrong file. -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <!-- Lets the Linux release runner compile the .NET Framework leg without a Windows toolchain.
       The single net472 build is what runs on 4.7.2 through 4.8.2 (there is no net482 TFM). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository README is shown on the package page and in client UIs. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
